{
	"schemaVersion": 1,
	"id": "minecrawlcombatoverhaul",
	"version": "${version}",
	"name": "Minecrawl",
	"description": "A mod about dungeon crawling in Minecraft",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/minecrawl"
	},
	"license": "MIT",
	"icon": "assets/minecrawlcombatoverhaul/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.minecrawlcombatoverhaul.MinecrawlCombatOverhaul"
		],
		"client": [
			"com.github.theredbrain.minecrawlcombatoverhaul.MinecrawlCombatOverhaulClient"
		]
	},
	"mixins": [
		"minecrawlcombatoverhaul.mixins.json",
		{
			"config": "minecrawlcombatoverhaul.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"fabric-api": "*",
		"variousstatuseffects": ">=${various_status_effects_version}",
		"scriptblocks": ">=${script_blocks_version}"
	},
	"suggests": {
		"spell_engine": "*",
		"spellengineextension": "*"
	}
}